module TrenzHat:
    signal LINK_ARMED_REQUEST
    signal FPGA_LINK_CS_N
    signal FPGA_LINK_DQ0
    signal FPGA_LINK_DQ1
    signal FPGA_LINK_DQ2
    signal FPGA_LINK_DQ3
    signal FPGA_LINK_SCLK
    signal LINK_CS_N
    signal LINK_DQ0
    signal LINK_DQ1
    signal LINK_DQ2
    signal LINK_DQ3
    signal LINK_FPGA_GOOD
    signal LINK_JTAG_SEL
    signal LINK_OE_N
    signal LINK_PI_GOOD
    signal LINK_REQUEST
    signal LINK_SCLK
    signal PI_LINK_CS_N
    signal PI_LINK_DQ0
    signal PI_LINK_DQ1
    signal PI_LINK_DQ2
    signal PI_LINK_DQ3
    signal PI_LINK_SCLK
    signal EEP_WP
    signal EXT_3V3
    signal FPGA_3V3
    signal FPGA_CONFIG_RESET_N
    signal FPGA_EN1
    signal FPGA_IO_ENABLE
    signal FPGA_JTAGEN
    signal FPGA_MODE
    signal FPGA_NOSEQ
    signal FPGA_PGOOD
    signal FPGA_RESET_GATE
    signal FPGA_RESET_GPIO
    signal FPGA_RESET_N
    signal FPGA_UART_DRIVE
    signal FPGA_UART_RX
    signal FPGA_UART_TX
    signal FPGA_VIN
    signal GND
    signal GEO_DRDY_N
    signal GEO_P
    signal GEO_N
    signal GEO_AIN_P
    signal GEO_AIN_N
    signal GEO_VCM
    signal GEO_AVDD
    signal I2C_SCL
    signal I2C_SDA
    signal ID_SCL
    signal ID_SDA
    signal IMU1_CS
    signal IMU1_INT
    signal IMU2_CS
    signal IMU2_INT
    signal IMU3_CS
    signal IMU3_INT
    signal IMU4_CS
    signal IMU4_INT
    signal JTAG_TCK
    signal JTAG_TDI
    signal JTAG_TDO
    signal JTAG_TMS
    signal PI_3V3
    signal PI_5V
    signal PI_GEO_DRDY_N
    signal PI_I2C_SCL
    signal PI_I2C_SDA
    signal PI_IMU1_CS
    signal PI_IMU1_INT
    signal PI_IMU2_CS
    signal PI_IMU2_INT
    signal PI_IMU3_CS
    signal PI_IMU3_INT
    signal PI_IMU4_CS
    signal PI_IMU4_INT
    signal PI_SPI_MISO
    signal PI_SPI_MOSI
    signal PI_SPI_SCLK
    signal PI_TILT_CS
    signal PI_UART_RX
    signal PI_UART_TX
