# Internal link switch, I2C control and independent rail supervisors.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import ElectricPower

component LINK_MUX:
    power = new ElectricPower
    power.hv ~ p16
    power.lv ~ p8
    assert power.voltage within 1.5V to 5.5V
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TMUX1574PWR", footprint="Package_SO__TSSOP-16_4.4x5mm_P0.65mm.kicad_mod", symbol="symbols/LINK_MUX.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16

component LINK_IO:
    power = new ElectricPower
    power.hv ~ p16
    power.lv ~ p8
    assert power.voltage within 1.65V to 5.5V
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TCA9534PWR", footprint="Package_SO__TSSOP-16_4.4x5mm_P0.65mm.kicad_mod", symbol="symbols/LINK_IO.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16

component LINK_NAND:
    power = new ElectricPower
    power.hv ~ p5
    power.lv ~ p2
    assert power.voltage within 1.65V to 5.5V
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="SN74LVC1G10DCKR", footprint="Package_TO_SOT_SMD__SOT-363_SC-70-6.kicad_mod", symbol="symbols/LINK_NAND.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6

component LINK_SUP:
    power = new ElectricPower
    power.hv ~ p3
    power.lv ~ p1
    assert power.voltage within 1.7V to 6V
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TLV809EA30DBZR", footprint="Package_TO_SOT_SMD__SOT-23.kicad_mod", symbol="symbols/LINK_SUP.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3

component LINK_AND:
    power = new ElectricPower
    power.hv ~ p5
    power.lv ~ p3
    assert power.voltage within 1.65V to 5.5V
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="SN74LVC1G08DCKR", footprint="Package_TO_SOT_SMD__SOT-353_SC-70-5.kicad_mod", symbol="symbols/LINK_AND.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5

