# A2: standalone USB-C sensor head; see docs/usb-sensor-head.md.
#pragma experiment("TRAITS")
import has_designator
import ElectricPower
import has_net_name_suggestion
from "parts.ato" import CF_R64
from "parts.ato" import CF_R66
from "parts.ato" import P_13
from "parts.ato" import P_26
from "parts.ato" import P_27
from "parts.ato" import P_28
from "parts.ato" import P_34
from "parts.ato" import P_35
from "parts.ato" import P_5
from "parts.ato" import P_6
from "parts.ato" import FieldUsbConnector
from "parts.ato" import USB_CIN
from "parts.ato" import USB_LDO
from "parts.ato" import USB_MCU
from "parts.ato" import USB_R51
from "parts.ato" import USB_SWD
from "parts.ato" import USB_SWITCH

module FieldHead:
    signal BOOT0
    signal GND
    signal MAG_DRDY
    signal NRST
    signal SCL
    signal SDA
    signal SENSOR_EN
    signal SWCLK
    signal SWDIO
    signal USB_5V
    signal USB_CC1
    signal USB_CC2
    signal USB_DM
    signal USB_DP
    signal USB_VBUS
    signal V3
    signal V3_SENSOR

    usb_supply = new ElectricPower
    usb_supply.hv ~ USB_5V
    usb_supply.lv ~ GND
    usb_supply.voltage = 4.35V to 5.25V

    supply = new ElectricPower
    supply.hv ~ V3
    supply.lv ~ GND
    supply.voltage = 3.234V to 3.366V

    sensor_supply = new ElectricPower
    sensor_supply.hv ~ V3_SENSOR
    sensor_supply.lv ~ GND
    sensor_supply.voltage = 3.20V to 3.366V

    j1 = new FieldUsbConnector
    trait j1 has_designator<designator="J1">
    j1.pA1 ~ GND
    j1.pA12 ~ GND
    j1.pB1 ~ GND
    j1.pB12 ~ GND
    j1.pS1 ~ GND
    j1.pA4 ~ USB_VBUS
    j1.pA9 ~ USB_VBUS
    j1.pB4 ~ USB_VBUS
    j1.pB9 ~ USB_VBUS
    j1.pA5 ~ USB_CC1
    j1.pB5 ~ USB_CC2
    j1.pA6 ~ USB_DP
    j1.pB6 ~ USB_DP
    j1.pA7 ~ USB_DM
    j1.pB7 ~ USB_DM

    r1 = new USB_R51
    trait r1 has_designator<designator="R1">
    r1.p1 ~ USB_CC1
    r1.p2 ~ GND

    r2 = new USB_R51
    trait r2 has_designator<designator="R2">
    r2.p1 ~ USB_CC2
    r2.p2 ~ GND

    d1 = new P_28
    trait d1 has_designator<designator="D1">
    d1.p1 ~ USB_DP
    d1.p2 ~ GND
    d1.p3 ~ USB_DM
    d1.p4 ~ USB_DM
    d1.p5 ~ USB_VBUS
    d1.p6 ~ USB_DP

    d2 = new P_28
    trait d2 has_designator<designator="D2">
    d2.p1 ~ USB_CC1
    d2.p2 ~ GND
    d2.p3 ~ USB_CC2
    d2.p4 ~ USB_CC2
    d2.p5 ~ USB_VBUS
    d2.p6 ~ USB_CC1

    f1 = new P_27
    trait f1 has_designator<designator="F1">
    f1.p1 ~ USB_VBUS
    f1.p2 ~ USB_5V

    u4 = new USB_LDO
    trait u4 has_designator<designator="U4">
    u4.p1 ~ USB_5V
    u4.p2 ~ GND
    u4.p3 ~ USB_5V
    u4.p5 ~ V3

    c1 = new USB_CIN
    trait c1 has_designator<designator="C1">
    c1.p1 ~ USB_5V
    c1.p2 ~ GND

    c2 = new P_13
    trait c2 has_designator<designator="C2">
    c2.p1 ~ V3
    c2.p2 ~ GND

    u1 = new USB_MCU
    trait u1 has_designator<designator="U1">
    u1.p1 ~ V3
    u1.p4 ~ NRST
    u1.p5 ~ V3
    u1.p6 ~ SENSOR_EN
    u1.p14 ~ MAG_DRDY
    u1.p16 ~ GND
    u1.p17 ~ V3
    u1.p21 ~ USB_DM
    u1.p22 ~ USB_DP
    u1.p23 ~ SWDIO
    u1.p24 ~ SWCLK
    u1.p29 ~ SCL
    u1.p30 ~ SDA
    u1.p31 ~ BOOT0
    u1.p32 ~ GND

    c3 = new P_6
    trait c3 has_designator<designator="C3">
    c3.p1 ~ V3
    c3.p2 ~ GND

    c6 = new P_6
    trait c6 has_designator<designator="C6">
    c6.p1 ~ V3
    c6.p2 ~ GND

    c7 = new P_6
    trait c7 has_designator<designator="C7">
    c7.p1 ~ V3
    c7.p2 ~ GND

    c8 = new P_6
    trait c8 has_designator<designator="C8">
    c8.p1 ~ NRST
    c8.p2 ~ GND

    r3 = new CF_R64
    trait r3 has_designator<designator="R3">
    r3.p1 ~ V3
    r3.p2 ~ NRST

    r4 = new CF_R64
    trait r4 has_designator<designator="R4">
    r4.p1 ~ BOOT0
    r4.p2 ~ GND

    j2 = new USB_SWD
    trait j2 has_designator<designator="J2">
    j2.p1 ~ V3
    j2.p2 ~ SWDIO
    j2.p3 ~ GND
    j2.p4 ~ SWCLK
    j2.p5 ~ NRST

    j3 = new P_5
    trait j3 has_designator<designator="J3">
    j3.p1 ~ V3
    j3.p2 ~ BOOT0

    u5 = new USB_SWITCH
    trait u5 has_designator<designator="U5">
    u5.p1 ~ V3
    u5.p2 ~ GND
    u5.p3 ~ SENSOR_EN
    u5.p5 ~ V3_SENSOR
    u5.p6 ~ V3_SENSOR

    r5 = new CF_R66
    trait r5 has_designator<designator="R5">
    r5.p1 ~ SENSOR_EN
    r5.p2 ~ GND

    c9 = new P_6
    trait c9 has_designator<designator="C9">
    c9.p1 ~ V3
    c9.p2 ~ GND

    r7 = new P_26
    trait r7 has_designator<designator="R7">
    r7.p1 ~ SDA
    r7.p2 ~ V3_SENSOR

    r8 = new P_26
    trait r8 has_designator<designator="R8">
    r8.p1 ~ SCL
    r8.p2 ~ V3_SENSOR

    u2 = new P_34
    trait u2 has_designator<designator="U2">
    u2.p1 ~ SCL
    u2.p2 ~ GND
    u2.p3 ~ SDA
    u2.p4 ~ GND
    u2.p5 ~ MAG_DRDY
    u2.p7 ~ GND
    u2.p10 ~ V3_SENSOR
    u2.p12 ~ V3_SENSOR
    u2.p13 ~ V3_SENSOR
    u2.p14 ~ GND

    c4 = new P_6
    trait c4 has_designator<designator="C4">
    c4.p1 ~ V3_SENSOR
    c4.p2 ~ GND

    u3 = new P_35
    trait u3 has_designator<designator="U3">
    u3.p1 ~ GND
    u3.p2 ~ V3_SENSOR
    u3.p3 ~ SDA
    u3.p4 ~ SCL

    c5 = new P_6
    trait c5 has_designator<designator="C5">
    c5.p1 ~ V3_SENSOR
    c5.p2 ~ GND

    u1.power ~ supply
    u4.input_power ~ usb_supply
    u4.output_power ~ supply
    u5.power ~ supply
    u2.power ~ sensor_supply
    u2.io ~ sensor_supply
    u3.power ~ sensor_supply
    trait BOOT0 has_net_name_suggestion<name="BOOT0", level="EXPECTED">
    trait GND has_net_name_suggestion<name="GND", level="EXPECTED">
    trait MAG_DRDY has_net_name_suggestion<name="MAG_DRDY", level="EXPECTED">
    trait NRST has_net_name_suggestion<name="NRST", level="EXPECTED">
    trait SCL has_net_name_suggestion<name="SCL", level="EXPECTED">
    trait SDA has_net_name_suggestion<name="SDA", level="EXPECTED">
    trait SENSOR_EN has_net_name_suggestion<name="SENSOR_EN", level="EXPECTED">
    trait SWCLK has_net_name_suggestion<name="SWCLK", level="EXPECTED">
    trait SWDIO has_net_name_suggestion<name="SWDIO", level="EXPECTED">
    trait USB_5V has_net_name_suggestion<name="USB_5V", level="EXPECTED">
    trait USB_CC1 has_net_name_suggestion<name="USB_CC1", level="EXPECTED">
    trait USB_CC2 has_net_name_suggestion<name="USB_CC2", level="EXPECTED">
    trait USB_DM has_net_name_suggestion<name="USB_DM", level="EXPECTED">
    trait USB_DP has_net_name_suggestion<name="USB_DP", level="EXPECTED">
    trait USB_VBUS has_net_name_suggestion<name="USB_VBUS", level="EXPECTED">
    trait V3 has_net_name_suggestion<name="V3", level="EXPECTED">
    trait V3_SENSOR has_net_name_suggestion<name="V3_SENSOR", level="EXPECTED">
