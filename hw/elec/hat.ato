    signal PI_I2C_SDA
    signal PI_IMU1_CS
    signal PI_IMU1_INT
    signal PI_IMU2_CS
    signal PI_IMU2_INT
    signal PI_IMU3_CS
    signal PI_IMU3_INT
    signal PI_IMU4_CS
    signal PI_IMU4_INT
    signal PI_SPI_MISO
    signal PI_SPI_MOSI
    signal PI_SPI_SCLK
