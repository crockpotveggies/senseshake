    signal SPI_MISO
    signal SPI_MOSI
    signal SPI_SCLK
    signal TILT_AEXT
    signal TILT_CS
    signal TILT_DEXT

    sensor_supply = new ElectricPower
    sensor_supply.hv ~ SENS_3V3
    sensor_supply.lv ~ GND
    sensor_supply.voltage = 3.18V to 3.42V
    assert sensor_supply.voltage within 3.0V to 3.6V
    pi_supply = new ElectricPower
    pi_supply.hv ~ PI_3V3
    pi_supply.lv ~ GND
    pi_supply.voltage = 3.135V to 3.465V
    input_supply = new ElectricPower
    input_supply.hv ~ PI_5V
    input_supply.lv ~ GND
    input_supply.voltage = 4.75V to 5.25V
    assert input_supply.voltage within 4.0V to 5.5V

    # 01-host-power
    # Raspberry Pi 40-pin: Samtec ESQ-120-23-G-D
    j1 = new P_1
    trait j1 has_designator<designator="J1">
    j1.p1 ~ PI_3V3
    j1.p2 ~ PI_5V
    j1.p3 ~ PI_I2C_SDA
    j1.p4 ~ PI_5V
    j1.p5 ~ PI_I2C_SCL
    j1.p6 ~ GND
    j1.p7 ~ PI_GNSS_PPS
    j1.p8 ~ PI_UART_TX
    j1.p9 ~ GND
    j1.p10 ~ PI_UART_RX
    j1.p11 ~ CF_RESET_GPIO
    # J1.12: intentionally unconnected
    j1.p13 ~ PI_IMU1_INT
    j1.p14 ~ GND
    j1.p15 ~ PI_IMU2_INT
    j1.p16 ~ PI_IMU3_INT
    j1.p17 ~ PI_3V3
    j1.p18 ~ PI_IMU4_INT
    j1.p19 ~ PI_SPI_MOSI
    j1.p20 ~ GND
    j1.p21 ~ PI_SPI_MISO
    j1.p22 ~ CF_IO_ENABLE
    j1.p23 ~ PI_SPI_SCLK
    j1.p24 ~ PI_IMU1_CS
    j1.p25 ~ GND
    j1.p26 ~ PI_IMU2_CS
    j1.p27 ~ ID_SDA
    j1.p28 ~ ID_SCL
    j1.p29 ~ PI_IMU3_CS
    j1.p30 ~ GND
    j1.p31 ~ PI_IMU4_CS
    # J1.32: intentionally unconnected
    j1.p33 ~ PI_TILT_CS
    j1.p34 ~ GND
    # J1.35: intentionally unconnected
    # J1.36: intentionally unconnected
    j1.p37 ~ SENSOR_OE_N
    # J1.38: intentionally unconnected
    j1.p39 ~ GND
    # J1.40: intentionally unconnected
    # 24LC32A: 24LC32A-I/SN
    u1 = new P_2
    trait u1 has_designator<designator="U1">
    u1.p1 ~ GND
    u1.p2 ~ GND
    u1.p3 ~ GND
    u1.p4 ~ GND
    u1.p5 ~ ID_SDA
    u1.p6 ~ ID_SCL
    u1.p7 ~ EEP_WP
    u1.p8 ~ PI_3V3
    # 3.9k: RC0603FR-073K9L
    r1 = new P_3
    trait r1 has_designator<designator="R1">
    r1.p1 ~ ID_SDA
    r1.p2 ~ PI_3V3
    # 3.9k: RC0603FR-073K9L
    r2 = new P_3
    trait r2 has_designator<designator="R2">
    r2.p1 ~ ID_SCL
    r2.p2 ~ PI_3V3
    # 1k: RC0603FR-071KL
    r3 = new P_4
    trait r3 has_designator<designator="R3">
    r3.p1 ~ EEP_WP
    r3.p2 ~ PI_3V3
    # EEPROM write enable: EEPROM write enable
    jp1 = new P_5
    trait jp1 has_designator<designator="JP1">
    jp1.p1 ~ EEP_WP
    jp1.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c1 = new P_6
    trait c1 has_designator<designator="C1">
    c1.p1 ~ PI_3V3
    c1.p2 ~ GND
    # 10u: GRM21BR61A106KE19L
    c2 = new P_7
    trait c2 has_designator<designator="C2">
    c2.p1 ~ PI_3V3
    c2.p2 ~ GND
    # 10u: GRM21BR61A106KE19L
    c3 = new P_7
    trait c3 has_designator<designator="C3">
    c3.p1 ~ PI_5V
    c3.p2 ~ GND

    # 02-motion-array
    # LSM6DSOTR: LSM6DSOTR
    u11 = new P_8
    trait u11 has_designator<designator="U11">
    u11.p1 ~ SPI_MISO
    u11.p2 ~ GND
    u11.p3 ~ GND
    u11.p4 ~ IMU1_INT
    u11.p5 ~ SENS_3V3
    u11.p6 ~ GND
    u11.p7 ~ GND
    u11.p8 ~ SENS_3V3
    # U11.9: intentionally unconnected
    # U11.10: intentionally unconnected
    # U11.11: intentionally unconnected
    u11.p12 ~ IMU1_CS
    u11.p13 ~ SPI_SCLK
    u11.p14 ~ SPI_MOSI
    # 100n: GRM155R71C104KA88D
    c12 = new P_9
    trait c12 has_designator<designator="C12">
    c12.p1 ~ SENS_3V3
    c12.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c13 = new P_9
    trait c13 has_designator<designator="C13">
    c13.p1 ~ SENS_3V3
    c13.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r11 = new P_10
    trait r11 has_designator<designator="R11">
    r11.p1 ~ IMU1_CS
    r11.p2 ~ SENS_3V3
    # LSM6DSOTR: LSM6DSOTR
    u12 = new P_8
    trait u12 has_designator<designator="U12">
    u12.p1 ~ SPI_MISO
    u12.p2 ~ GND
    u12.p3 ~ GND
    u12.p4 ~ IMU2_INT
    u12.p5 ~ SENS_3V3
    u12.p6 ~ GND
    u12.p7 ~ GND
    u12.p8 ~ SENS_3V3
    # U12.9: intentionally unconnected
    # U12.10: intentionally unconnected
    # U12.11: intentionally unconnected
    u12.p12 ~ IMU2_CS
    u12.p13 ~ SPI_SCLK
    u12.p14 ~ SPI_MOSI
    # 100n: GRM155R71C104KA88D
    c14 = new P_9
    trait c14 has_designator<designator="C14">
    c14.p1 ~ SENS_3V3
    c14.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c15 = new P_9
    trait c15 has_designator<designator="C15">
    c15.p1 ~ SENS_3V3
    c15.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r12 = new P_10
    trait r12 has_designator<designator="R12">
    r12.p1 ~ IMU2_CS
    r12.p2 ~ SENS_3V3
    # LSM6DSOTR: LSM6DSOTR
    u13 = new P_8
    trait u13 has_designator<designator="U13">
    u13.p1 ~ SPI_MISO
    u13.p2 ~ GND
    u13.p3 ~ GND
    u13.p4 ~ IMU3_INT
    u13.p5 ~ SENS_3V3
    u13.p6 ~ GND
    u13.p7 ~ GND
    u13.p8 ~ SENS_3V3
    # U13.9: intentionally unconnected
    # U13.10: intentionally unconnected
    # U13.11: intentionally unconnected
    u13.p12 ~ IMU3_CS
    u13.p13 ~ SPI_SCLK
    u13.p14 ~ SPI_MOSI
    # 100n: GRM155R71C104KA88D
    c16 = new P_9
    trait c16 has_designator<designator="C16">
    c16.p1 ~ SENS_3V3
    c16.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c17 = new P_9
    trait c17 has_designator<designator="C17">
    c17.p1 ~ SENS_3V3
    c17.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r13 = new P_10
    trait r13 has_designator<designator="R13">
    r13.p1 ~ IMU3_CS
    r13.p2 ~ SENS_3V3
    # LSM6DSOTR: LSM6DSOTR
    u14 = new P_8
    trait u14 has_designator<designator="U14">
    u14.p1 ~ SPI_MISO
    u14.p2 ~ GND
    u14.p3 ~ GND
    u14.p4 ~ IMU4_INT
    u14.p5 ~ SENS_3V3
    u14.p6 ~ GND
    u14.p7 ~ GND
    u14.p8 ~ SENS_3V3
    # U14.9: intentionally unconnected
    # U14.10: intentionally unconnected
    # U14.11: intentionally unconnected
    u14.p12 ~ IMU4_CS
    u14.p13 ~ SPI_SCLK
    u14.p14 ~ SPI_MOSI
    # 100n: GRM155R71C104KA88D
    c18 = new P_9
    trait c18 has_designator<designator="C18">
    c18.p1 ~ SENS_3V3
    c18.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c19 = new P_9
    trait c19 has_designator<designator="C19">
    c19.p1 ~ SENS_3V3
    c19.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r14 = new P_10
    trait r14 has_designator<designator="R14">
    r14.p1 ~ IMU4_CS
    r14.p2 ~ SENS_3V3

    # 03-level-position
    # SCL3300-D01: SCL3300-D01-10
    u20 = new P_11
    trait u20 has_designator<designator="U20">
    u20.p1 ~ GND
    u20.p2 ~ TILT_AEXT
    u20.p3 ~ GND
    u20.p4 ~ SENS_3V3
    u20.p5 ~ TILT_CS
    u20.p6 ~ SPI_MISO
    u20.p7 ~ SPI_MOSI
    u20.p8 ~ SPI_SCLK
    u20.p9 ~ SENS_3V3
    u20.p10 ~ TILT_DEXT
    u20.p11 ~ GND
    u20.p12 ~ GND
    # 100n: GRM155R71C104KA88D
    c20 = new P_9
    trait c20 has_designator<designator="C20">
    c20.p1 ~ SENS_3V3
    c20.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c21 = new P_9
    trait c21 has_designator<designator="C21">
    c21.p1 ~ TILT_AEXT
    c21.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c22 = new P_9
    trait c22 has_designator<designator="C22">
    c22.p1 ~ SENS_3V3
    c22.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c23 = new P_9
    trait c23 has_designator<designator="C23">
    c23.p1 ~ TILT_DEXT
    c23.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r20 = new P_10
    trait r20 has_designator<designator="R20">
    r20.p1 ~ TILT_CS
    r20.p2 ~ SENS_3V3
    # MAX-M10S: MAX-M10S-00B
    u21 = new P_12
    trait u21 has_designator<designator="U21">
    u21.p1 ~ GND
    # U21.2: intentionally unconnected
    # U21.3: intentionally unconnected
    u21.p4 ~ GNSS_PPS
    u21.p5 ~ GND
    # U21.6: intentionally unconnected
    u21.p7 ~ SENS_3V3
    u21.p8 ~ SENS_3V3
    # U21.9: intentionally unconnected
    u21.p10 ~ GND
    u21.p11 ~ GNSS_RF
    u21.p12 ~ GND
    # U21.13: intentionally unconnected
    # U21.14: intentionally unconnected
    # U21.15: intentionally unconnected
    u21.p16 ~ I2C_SDA
    u21.p17 ~ I2C_SCL
    # U21.18: intentionally unconnected
    # 100n: GRM188R71H104KA93D
    c24 = new P_6
    trait c24 has_designator<designator="C24">
    c24.p1 ~ SENS_3V3
    c24.p2 ~ GND
    # 4.7u: GRM21BR71A475KA73L
    c25 = new P_13
    trait c25 has_designator<designator="C25">
    c25.p1 ~ SENS_3V3
    c25.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c26 = new P_6
    trait c26 has_designator<designator="C26">
    c26.p1 ~ SENS_3V3
    c26.p2 ~ GND
    # Passive GNSS antenna: U.FL-R-SMT-1(10)
    j2 = new P_14
    trait j2 has_designator<designator="J2">
    j2.p1 ~ GNSS_RF
    j2.p2 ~ GND

    # 04-remote-sensors
    # 100n: GRM188R71H104KA93D
    # 100n: GRM188R71H104KA93D
    # 390: RC0603FR-07390RL
    # 120: RC0603FR-07120RL
    # 390: RC0603FR-07390RL
    # 390: RC0603FR-07390RL
    # 120: RC0603FR-07120RL
    # 390: RC0603FR-07390RL
    # 05-coldfoot-interface
    # 47: RC0603FR-0747RL
    # 47: RC0603FR-0747RL
    # 47: RC0603FR-0747RL
    # Coldfoot UART service ONLY: Coldfoot UART service ONLY
    j4 = new P_20
    trait j4 has_designator<designator="J4">
    j4.p1 ~ GND
    j4.p2 ~ CF_UART_RX
    j4.p3 ~ CF_UART_TX
    j4.p4 ~ CF_RESET_N

    # 06-supply-isolation
    # TLV1117LV33DCYR: TLV1117LV33DCYR
    u40 = new P_21
    trait u40 has_designator<designator="U40">
    u40.p1 ~ GND
    u40.p2 ~ SENS_3V3
    u40.p3 ~ PI_5V
    # 10u: GRM21BR61A106KE19L
    c40 = new P_7
    trait c40 has_designator<designator="C40">
    c40.p1 ~ PI_5V
    c40.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c41 = new P_6
    trait c41 has_designator<designator="C41">
    c41.p1 ~ PI_5V
    c41.p2 ~ GND
    # 22u: GRM31CR61A226KE19L
    c42 = new P_22
    trait c42 has_designator<designator="C42">
    c42.p1 ~ SENS_3V3
    c42.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c43 = new P_6
    trait c43 has_designator<designator="C43">
    c43.p1 ~ SENS_3V3
    c43.p2 ~ GND
    # SN74LVC8T245PWR: SN74LVC8T245PWR
    u41 = new P_23
    trait u41 has_designator<designator="U41">
    u41.p1 ~ PI_3V3
    u41.p2 ~ PI_3V3
    u41.p11 ~ GND
    u41.p12 ~ GND
    u41.p13 ~ GND
    u41.p22 ~ SENSOR_OE_N
    u41.p23 ~ SENS_3V3
    u41.p24 ~ SENS_3V3
    u41.p3 ~ PI_SPI_MOSI
    u41.p21 ~ SPI_MOSI
    u41.p4 ~ PI_SPI_SCLK
    u41.p20 ~ SPI_SCLK
    u41.p5 ~ PI_IMU1_CS
    u41.p19 ~ IMU1_CS
    u41.p6 ~ PI_IMU2_CS
    u41.p18 ~ IMU2_CS
    u41.p7 ~ PI_IMU3_CS
    u41.p17 ~ IMU3_CS
    u41.p8 ~ PI_IMU4_CS
    u41.p16 ~ IMU4_CS
    u41.p9 ~ PI_TILT_CS
    u41.p15 ~ TILT_CS
    u41.p10 ~ GND
    # U41.14: intentionally unconnected
    # SN74LVC8T245PWR: SN74LVC8T245PWR
    u42 = new P_23
    trait u42 has_designator<designator="U42">
    u42.p1 ~ PI_3V3
    u42.p2 ~ GND
    u42.p11 ~ GND
    u42.p12 ~ GND
    u42.p13 ~ GND
