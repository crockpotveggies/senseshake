# Explicit manufacturer-selected parts. Pin numbers are physical pads.
# Pin-map sources and limitations: docs/sources.md.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import ElectricPower

component P_1:
    trait is_atomic_part<manufacturer="See datasheet", partnumber="Samtec ESQ-120-23-G-D", footprint="Connector_PinHeader_2.54mm__PinHeader_2x20_P2.54mm_Vertical.kicad_mod", symbol="symbols/P_1.kicad_sym">
    trait has_designator_prefix<prefix="J">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16
    signal p17 ~ pin 17
    signal p18 ~ pin 18
    signal p19 ~ pin 19
    signal p20 ~ pin 20
    signal p21 ~ pin 21
    signal p22 ~ pin 22
    signal p23 ~ pin 23
    signal p24 ~ pin 24
    signal p25 ~ pin 25
    signal p26 ~ pin 26
    signal p27 ~ pin 27
    signal p28 ~ pin 28
    signal p29 ~ pin 29
    signal p30 ~ pin 30
    signal p31 ~ pin 31
    signal p32 ~ pin 32
    signal p33 ~ pin 33
    signal p34 ~ pin 34
    signal p35 ~ pin 35
    signal p36 ~ pin 36
    signal p37 ~ pin 37
    signal p38 ~ pin 38
    signal p39 ~ pin 39
    signal p40 ~ pin 40

component P_2:
    power = new ElectricPower
    power.hv ~ p8
    power.lv ~ p4
    assert power.voltage within 2.5V to 5.5V
    trait is_atomic_part<manufacturer="See datasheet", partnumber="24LC32A-I/SN", footprint="Package_SO__SOIC-8_3.9x4.9mm_P1.27mm.kicad_mod", symbol="symbols/P_2.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1  # A0
    signal p2 ~ pin 2  # A1
    signal p3 ~ pin 3  # A2
    signal p4 ~ pin 4  # VSS
    signal p5 ~ pin 5  # SDA
    signal p6 ~ pin 6  # SCL
    signal p7 ~ pin 7  # WP
    signal p8 ~ pin 8  # VCC

component P_3:
    resistance: ohm
    resistance = 3.9kohm +/- 1%
