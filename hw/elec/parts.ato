component USB_MCU:
    power = new ElectricPower
    power.hv ~ p1
    power.lv ~ p32
    assert power.voltage within 3V to 3.6V
    trait is_atomic_part<manufacturer="See datasheet", partnumber="STM32F042K6T6", footprint="Package_QFP__LQFP-32_7x7mm_P0.8mm.kicad_mod", symbol="symbols/USB_MCU.kicad_sym">
