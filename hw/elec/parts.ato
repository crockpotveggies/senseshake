component USB_LDO:
    input_power = new ElectricPower
    input_power.hv ~ p1
    input_power.lv ~ p2
    assert input_power.voltage within 2.5V to 6V
    output_power = new ElectricPower
    output_power.hv ~ p5
    output_power.lv ~ p2
    assert output_power.voltage within 3.234V to 3.366V
    trait is_atomic_part<manufacturer="See datasheet", partnumber="AP2112K-3.3TRG1", footprint="Package_TO_SOT_SMD__SOT-23-5.kicad_mod", symbol="symbols/USB_LDO.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5

component USB_SWITCH:
    power = new ElectricPower
    power.hv ~ p1
    power.lv ~ p2
    assert power.voltage within 1.6V to 5.5V
    trait is_atomic_part<manufacturer="See datasheet", partnumber="TPS22919DCKR", footprint="Package_TO_SOT_SMD__SOT-363_SC-70-6.kicad_mod", symbol="symbols/USB_SWITCH.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6

