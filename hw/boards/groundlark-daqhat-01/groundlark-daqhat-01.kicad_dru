(version 1)
# JLCPCB standard multilayer/POFV capability; no HDI.
(rule "Via copper clearance" (condition "A.Type == 'Via' || B.Type == 'Via'") (constraint clearance (min 0.125mm)))
(rule "SMD pad spacing" (condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'") (constraint clearance (min 0.15mm)))
(rule "PTH drill to copper" (condition "A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.3mm)))
(rule "Component drill spacing" (condition "A.Type == 'Pad' || B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
