# Nanopb candidate allocation bounds. Firmware selection still needs a linked
# STM32 image, stack watermark and USB-buffer RAM/flash measurements.
senseshake.sensor.v1.Envelope.device_id max_length:32
senseshake.sensor.v1.Identity.firmware_version max_length:32
senseshake.sensor.v1.Identity.sensors max_count:8
senseshake.sensor.v1.Configuration.sensors max_count:8
senseshake.sensor.v1.SensorConfiguration.register_config max_size:64
senseshake.sensor.v1.SensorConfiguration.pressure_part_number max_length:32
senseshake.sensor.v1.PressureRaw.response max_size:4
senseshake.sensor.v1.GnssRaw.nav_pvt max_size:92
senseshake.sensor.v1.SampleBatch.samples max_count:4
senseshake.sensor.v1.SampleBatch.calibration_id max_length:32
senseshake.sensor.v1.DeviceStatus.detail max_length:96
