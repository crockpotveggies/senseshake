    # J83: 1715721; REGULATED 3.3 V ONLY; current-limited external supply, 3 A initial operating budget
    j83 = new TZ_POWER
    trait j83 has_designator<designator="J83">
    j83.p1 ~ EXT_3V3
    j83.p2 ~ GND

    # F80: 0467005.NR; 5 A fast fuse; not reverse-polarity or overvoltage protection
    f80 = new TZ_FUSE
    trait f80 has_designator<designator="F80">
    f80.p1 ~ EXT_3V3
    f80.p2 ~ FPGA_VIN

    # J84: TSW-106-07-G-S; Digilent 6-pin JTAG signal order; reference is an output, not a power input
    j84 = new TZ_JTAG
    trait j84 has_designator<designator="J84">
    j84.p1 ~ JTAG_TMS
    j84.p2 ~ JTAG_TDI
    j84.p3 ~ JTAG_TDO
    j84.p4 ~ JTAG_TCK
    j84.p5 ~ GND
    j84.p6 ~ FPGA_3V3

    # J85: TSW-103-07-G-D; 3.3 V spare I/O; fit cable before stacking
    j85 = new TZ_AUX
    trait j85 has_designator<designator="J85">
