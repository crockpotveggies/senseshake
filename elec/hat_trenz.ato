module TrenzHat:
    signal EEP_WP
    signal EXT_3V3
    signal FPGA_3V3
    signal FPGA_AUX0
    signal FPGA_AUX1
    signal FPGA_AUX2
    signal FPGA_CONFIG_RESET_N
    signal FPGA_EN1
    signal FPGA_IO_ENABLE
    signal FPGA_JTAGEN
    signal FPGA_MODE
    signal FPGA_NOSEQ
    signal FPGA_PGOOD
    signal FPGA_RESET_GATE
    signal FPGA_RESET_GPIO
    signal FPGA_RESET_N
    signal FPGA_UART_DRIVE
    signal FPGA_UART_RX
    signal FPGA_UART_TX
    signal FPGA_VIN
    signal GND
    signal GNSS_PPS
    signal GNSS_RF
    signal I2C_SCL
    signal I2C_SDA
    signal ID_SCL
    signal ID_SDA
    signal IMU1_CS
    signal IMU1_INT
    signal IMU2_CS
    signal IMU2_INT
    signal IMU3_CS
    signal IMU3_INT
    signal IMU4_CS
    signal IMU4_INT
    signal JTAG_TCK
    signal JTAG_TDI
    signal JTAG_TDO
    signal JTAG_TMS
    signal PI_3V3
    signal PI_5V
    signal PI_GNSS_PPS
    signal PI_I2C_SCL
    signal PI_I2C_SDA
    signal PI_IMU1_CS
    signal PI_IMU1_INT
    signal PI_IMU2_CS
    signal PI_IMU2_INT
    signal PI_IMU3_CS
    signal PI_IMU3_INT
    signal PI_IMU4_CS
    signal PI_IMU4_INT
    signal PI_SPI_MISO
    signal PI_SPI_MOSI
    signal PI_SPI_SCLK
    signal PI_TILT_CS
    signal PI_UART_RX
    signal PI_UART_TX
    signal SENSOR_OE_N
    signal SENS_3V3
    signal SPI_MISO
    signal SPI_MOSI
    signal SPI_SCLK
    signal TILT_AEXT
    signal TILT_CS
    signal TILT_DEXT

    sensor_supply = new ElectricPower
    sensor_supply.hv ~ SENS_3V3
    sensor_supply.lv ~ GND
    sensor_supply.voltage = 3.18V to 3.42V
    assert sensor_supply.voltage within 3.0V to 3.6V
    pi_supply = new ElectricPower
    pi_supply.hv ~ PI_3V3
    pi_supply.lv ~ GND
    pi_supply.voltage = 3.135V to 3.465V
    input_supply = new ElectricPower
    input_supply.hv ~ PI_5V
    input_supply.lv ~ GND
    input_supply.voltage = 4.75V to 5.25V
    assert input_supply.voltage within 4.0V to 5.5V

    # 01-host-power
    # Raspberry Pi 40-pin: Samtec ESQ-120-23-G-D
    j1 = new P_1
    trait j1 has_designator<designator="J1">
    j1.p1 ~ PI_3V3
    j1.p2 ~ PI_5V
    j1.p3 ~ PI_I2C_SDA
    j1.p4 ~ PI_5V
    j1.p5 ~ PI_I2C_SCL
    j1.p6 ~ GND
    j1.p7 ~ PI_GNSS_PPS
    j1.p8 ~ PI_UART_TX
    j1.p9 ~ GND
    j1.p10 ~ PI_UART_RX
    j1.p11 ~ FPGA_RESET_GPIO
    # J1.12: intentionally unconnected
    j1.p13 ~ PI_IMU1_INT
    j1.p14 ~ GND
    j1.p15 ~ PI_IMU2_INT
    j1.p16 ~ PI_IMU3_INT
    j1.p17 ~ PI_3V3
    j1.p18 ~ PI_IMU4_INT
    j1.p19 ~ PI_SPI_MOSI
    j1.p20 ~ GND
    j1.p21 ~ PI_SPI_MISO
    j1.p22 ~ FPGA_IO_ENABLE
    j1.p23 ~ PI_SPI_SCLK
    j1.p24 ~ PI_IMU1_CS
    j1.p25 ~ GND
    j1.p26 ~ PI_IMU2_CS
    j1.p27 ~ ID_SDA
    j1.p28 ~ ID_SCL
    j1.p29 ~ PI_IMU3_CS
    j1.p30 ~ GND
    j1.p31 ~ PI_IMU4_CS
    # J1.32: intentionally unconnected
    j1.p33 ~ PI_TILT_CS
    j1.p34 ~ GND
    # J1.35: intentionally unconnected
    # J1.36: intentionally unconnected
    j1.p37 ~ SENSOR_OE_N
    # J1.38: intentionally unconnected
    j1.p39 ~ GND
    # J1.40: intentionally unconnected
    # 24LC32A: 24LC32A-I/SN
    u1 = new P_2
    trait u1 has_designator<designator="U1">
    u1.p1 ~ GND
    u1.p2 ~ GND
    u1.p3 ~ GND
    u1.p4 ~ GND
    u1.p5 ~ ID_SDA
    u1.p6 ~ ID_SCL
    u1.p7 ~ EEP_WP
    u1.p8 ~ PI_3V3
    # 3.9k: RC0603FR-073K9L
    r1 = new P_3
    trait r1 has_designator<designator="R1">
    r1.p1 ~ ID_SDA
    r1.p2 ~ PI_3V3
    # 3.9k: RC0603FR-073K9L
    r2 = new P_3
    trait r2 has_designator<designator="R2">
    r2.p1 ~ ID_SCL
    r2.p2 ~ PI_3V3
    # 1k: RC0603FR-071KL
    r3 = new P_4
    trait r3 has_designator<designator="R3">
    r3.p1 ~ EEP_WP
    r3.p2 ~ PI_3V3
    # EEPROM write enable: EEPROM write enable
    jp1 = new P_5
    trait jp1 has_designator<designator="JP1">
    jp1.p1 ~ EEP_WP
    jp1.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c1 = new P_6
    trait c1 has_designator<designator="C1">
    c1.p1 ~ PI_3V3
    c1.p2 ~ GND
    # 10u: GRM21BR61A106KE19L
    c2 = new P_7
    trait c2 has_designator<designator="C2">
    c2.p1 ~ PI_3V3
    c2.p2 ~ GND
    # 10u: GRM21BR61A106KE19L
    c3 = new P_7
    trait c3 has_designator<designator="C3">
    c3.p1 ~ PI_5V
    c3.p2 ~ GND

    # 02-motion-array
    # LSM6DSOTR: LSM6DSOTR
    u11 = new P_8
