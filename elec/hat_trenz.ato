    u1.power ~ pi_supply
    u11.power ~ sensor_supply
    u11.io ~ sensor_supply
    u12.power ~ sensor_supply
    u12.io ~ sensor_supply
    u13.power ~ sensor_supply
    u13.io ~ sensor_supply
    u14.power ~ sensor_supply
    u14.io ~ sensor_supply
    u20.power ~ sensor_supply
    u20.io ~ sensor_supply
    u21.power ~ sensor_supply
    u21.io ~ sensor_supply
    u40.input_power ~ input_supply
    u40.output_power ~ sensor_supply
    u41.host_power ~ pi_supply
    u41.sensor_power ~ sensor_supply
    u42.host_power ~ pi_supply
    u42.sensor_power ~ sensor_supply
    u43.host_power ~ pi_supply
    u43.sensor_power ~ sensor_supply

    u51 = new CF_U51
    trait u51 has_designator<designator="U51">
    u51.p1 ~ FPGA_UART_TX
    u51.p2 ~ GND
    u51.p3 ~ PI_3V3
    u51.p4 ~ PI_UART_RX
    u51.p5 ~ PI_UART_TX
    u51.p6 ~ FPGA_IO_ENABLE
    u51.p7 ~ FPGA_3V3
    u51.p8 ~ FPGA_UART_DRIVE
    # 100n / GRM188R71H104KA93D
    c75 = new CF_C75
    trait c75 has_designator<designator="C75">
    c75.p1 ~ PI_3V3
    c75.p2 ~ GND
    # 100n / GRM188R71H104KA93D
    c76 = new CF_C76
    trait c76 has_designator<designator="C76">
    c76.p1 ~ FPGA_3V3
    c76.p2 ~ GND
    # 47 / RC0603FR-0747RL
    r61 = new CF_R61
    trait r61 has_designator<designator="R61">
    r61.p1 ~ FPGA_UART_DRIVE
    r61.p2 ~ FPGA_UART_RX
    # 100k / RC0603FR-07100KL
    r62 = new CF_R62
    trait r62 has_designator<designator="R62">
    r62.p1 ~ FPGA_IO_ENABLE
    r62.p2 ~ GND
    # 10k / RC0603FR-0710KL
    r63 = new CF_R63
    trait r63 has_designator<designator="R63">
    r63.p1 ~ FPGA_UART_RX
    r63.p2 ~ FPGA_3V3
    # TLV803EA30DBZR / TLV803EA30DBZR
    u52 = new CF_U52
    trait u52 has_designator<designator="U52">
    u52.p1 ~ GND
    u52.p2 ~ FPGA_RESET_N
    u52.p3 ~ FPGA_3V3
    # 100n / GRM188R71H104KA93D
    c77 = new CF_C77
    trait c77 has_designator<designator="C77">
    c77.p1 ~ FPGA_3V3
    c77.p2 ~ GND
