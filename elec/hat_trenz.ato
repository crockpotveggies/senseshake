    trait r66 has_designator<designator="R66">
    r66.p1 ~ FPGA_RESET_GATE
    r66.p2 ~ GND

    # J80: LSHM-150-04.0-L-DV-A-S-K-TR; Mates JM1; opposite parity; 8 mm board surface gap
    j80 = new TZ100
    trait j80 has_designator<designator="J80">
    j80.p2 ~ FPGA_VIN
    j80.p4 ~ FPGA_VIN
    j80.p6 ~ FPGA_VIN
