    j2.p2 ~ GND

    # 04-remote-sensors
    # 100n: GRM188R71H104KA93D
    # 100n: GRM188R71H104KA93D
    # 390: RC0603FR-07390RL
    # 120: RC0603FR-07120RL
    # 390: RC0603FR-07390RL
    # 390: RC0603FR-07390RL
    # 120: RC0603FR-07120RL
    # 390: RC0603FR-07390RL
