    fpga_supply = new ElectricPower
    fpga_supply.hv ~ FPGA_3V3
    fpga_supply.lv ~ GND
    fpga_supply.voltage = 3.201V to 3.399V
    assert fpga_supply.voltage within 3.0V to 3.6V
    external_supply = new ElectricPower
    external_supply.hv ~ FPGA_VIN
    external_supply.lv ~ GND
    external_supply.voltage = 3.201V to 3.399V
    assert external_supply.voltage within 3.201V to 3.399V
