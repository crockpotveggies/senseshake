    # J81: LSHM-150-04.0-L-DV-A-S-K-TR; Mates JM2; opposite parity; 8 mm board surface gap
    j81 = new TZ100
    trait j81 has_designator<designator="J81">
    j81.p1 ~ FPGA_VIN
    j81.p3 ~ FPGA_VIN
