    j4.p1 ~ GND
    j4.p2 ~ FPGA_UART_RX
    j4.p3 ~ FPGA_UART_TX
    j4.p4 ~ FPGA_RESET_N

    # 06-supply-isolation
    # TLV1117LV33DCYR: TLV1117LV33DCYR
