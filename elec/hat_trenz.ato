    # 03-level-position
    # SCL3300-D01: SCL3300-D01-10
    u20 = new P_11
    trait u20 has_designator<designator="U20">
    u20.p1 ~ GND
    u20.p2 ~ TILT_AEXT
    u20.p3 ~ GND
    u20.p4 ~ SENS_3V3
